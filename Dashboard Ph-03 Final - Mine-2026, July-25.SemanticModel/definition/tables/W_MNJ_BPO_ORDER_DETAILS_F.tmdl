	column Buyer_Name_Short = ```
			
			LOOKUPVALUE(
			    'W_MNJ_CUSTOMER_D'[Buyer Name short],
			    'W_MNJ_CUSTOMER_D'[CUSTOMER_ID], 'W_MNJ_BPO_ORDER_DETAILS_F'[BUYER_ID]
			)
			
			```
		lineageTag: d0d736e0-2a7d-45cb-863c-5f622829ec26
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Financial_Year = ```
			
			LOOKUPVALUE(
			    'Calendar'[Financial_Year],
			    'Calendar'[Date], 'W_MNJ_BPO_ORDER_DETAILS_F'[SHIPMENT_DATE]
			)
			
			```
		lineageTag: b5db3b27-27ae-4083-897e-d731b3b7ce40
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column YearF = ```
			
			SWITCH(
			    'W_MNJ_BPO_ORDER_DETAILS_F'[Financial_Year],
			    "2022-2023", DATE(2022, 7, 15),
			    "2023-2024", DATE(2023, 7, 15),
			    "2024-2025", DATE(2024, 7, 15),
			    "2025-2026", DATE(2025, 7, 15),
			    "2019-2020", DATE(2019, 7, 15),
			    "2020-2021", DATE(2020, 7, 15),
			    "2021-2022", DATE(2021, 7, 15),
			    "2018-2019", DATE(2018, 7, 15),
			    "2017-2018", DATE(2017, 7, 15),
			    "2016-2017", DATE(2016, 7, 15),
			    "2015-2016", DATE(2015, 7, 15),
			    BLANK()
			)
			
			```
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7cc4bb98-bdac-4c84-be90-ee6455fcff2d
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 56b791ba-28ce-4a7d-8332-cdebb4a725e4
			defaultHierarchy: LocalDateTable_d66c8f1b-eccb-439a-b6ed-54f1ca0fb4c9.'Date Hierarchy'

		changedProperty = DataType

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column END_USER_Lookup =
			
			MAXX(
			    FILTER(
			        W_MNJ_POC_H_D,
			        W_MNJ_POC_H_D[POC_ID] = W_MNJ_BPO_ORDER_DETAILS_F[POC_ID]
			    ),
			    W_MNJ_POC_H_D[END_USER]
			)
		lineageTag: 2ef9e6e9-b57f-4803-b5b3-b352edaa63d9
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Oracle Color' =
			
			MAXX(
			    FILTER(
			        FactOrderDetails,
			        FactOrderDetails[BPO] = W_MNJ_BPO_ORDER_DETAILS_F[BPO_NO]
			    ),
			    FactOrderDetails[COLOR]
			)
		lineageTag: 50a5ffe3-83c1-4016-a655-4610f2a51e1c
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column STYLE_Lookup =
			
			MAXX(
			    FILTER(
			        W_MNJ_POC_H_D,
			        W_MNJ_POC_H_D[POC_ID] = W_MNJ_BPO_ORDER_DETAILS_F[POC_ID]
			    ),
			    W_MNJ_POC_H_D[STYLE]
			)
		lineageTag: 21e4ffea-ed6d-4a89-a5a1-bc7844554f2c
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column BRAND_Lookup =
			
			MAXX(
			    FILTER(
			        F_COST_SUMM,
			        F_COST_SUMM[POC_ID] = W_MNJ_BPO_ORDER_DETAILS_F[POC_ID]
			    ),
			    F_COST_SUMM[BRAND]
			)
		lineageTag: cf60fc14-cb1f-416a-a631-5b6abc87fc9f
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Mapped_Color = ```
			
			IF(
			    ISBLANK(
			        LOOKUPVALUE(
			            ColorMapping[Color Show], 
			            ColorMapping[Oracle Color], 
			            W_MNJ_BPO_ORDER_DETAILS_F[Oracle Color]
			        )
			    ),
			    W_MNJ_BPO_ORDER_DETAILS_F[Oracle Color], -- Keep original value if no match
			    LOOKUPVALUE(
			        ColorMapping[Color Show], 
			        ColorMapping[Oracle Color], 
			        W_MNJ_BPO_ORDER_DETAILS_F[Oracle Color]
			    )
			)
			```
		lineageTag: be9b6c17-5f8f-45a0-9336-dee0cae2fb84
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Shipdate_Year = YEAR(W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE])
		dataType: int64
		formatString: 0
		lineageTag: ae759fff-8405-4ac7-93be-4e4cc5e96bff
		summarizeBy: sum

		changedProperty = DataType

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column FilterYesterdayAnd21 =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] >= TODAY() - 7 &&
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] <= TODAY() + 21,
			    1,
			    0
			)
		formatString: 0
		lineageTag: f71db606-1367-4752-8063-ce85d11713f3
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column FilterPreviousYear4week =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] >= (TODAY() - 7) - 365 &&
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] <= (TODAY() + 21) - 365,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 530d38f9-e131-4fa9-9f2e-501d37bc4253
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ShipmentDateFilteredNext10Days =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] >= TODAY() &&
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE] <= TODAY() + 10,
			    W_MNJ_BPO_ORDER_DETAILS_F[SHIPMENT_DATE],
			    BLANK()
			)
		formatString: General Date
		lineageTag: 9b74e93e-eecb-483c-a2df-fdc8e5df0fb3
		summarizeBy: none

		variation Variation
			isDefault
			relationship: eb93ccb9-931e-4e4d-b5ef-d44ea5300987
			defaultHierarchy: LocalDateTable_b30fcbdc-6e5d-47de-b446-20fe6a923c6c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column STITCH_Balance =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY] - W_MNJ_BPO_ORDER_DETAILS_F[STITCH_QTY] < 0,
			    0,
			    W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY] - W_MNJ_BPO_ORDER_DETAILS_F[STITCH_QTY]
			)
