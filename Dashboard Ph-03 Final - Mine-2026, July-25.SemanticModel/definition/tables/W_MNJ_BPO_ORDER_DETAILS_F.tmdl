	column Dept_TGA =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[BUYER_ID] = 1051,  // Filter for BUYER_ID = 1051
			    LOOKUPVALUE(
			        TGADept[Dept.],                          // Column to return
			        TGADept[STYLE_Lookup],                   // Column to match
			        LEFT(W_MNJ_BPO_ORDER_DETAILS_F[STYLE_Lookup], 3) // First 3 characters of STYLE_Lookup
			    ),
			    BLANK()                                     // Leave blank for other BUYER_ID values
			)
		lineageTag: a6af5715-5244-4e8f-85be-c28ff1742d14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SEASONS_Lookup =
			
			COALESCE(
			    MAXX(
			        FILTER(
			            W_MNJ_POC_H_D,
			            W_MNJ_POC_H_D[POC_ID] = W_MNJ_BPO_ORDER_DETAILS_F[POC_ID]
			        ),
			        W_MNJ_POC_H_D[SEASONs]
			    ),
			    "NotFound"
			)
		lineageTag: c975fc34-bc98-4492-8408-2b2ba3344270
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column StyleNewRepeatTGA =
			
			IF(
			    W_MNJ_BPO_ORDER_DETAILS_F[BUYER_ID] = 1051,
			    VAR CurrentSeason = W_MNJ_BPO_ORDER_DETAILS_F[SEASONS_Lookup]
			    VAR CurrentStyle = W_MNJ_BPO_ORDER_DETAILS_F[STYLE_Lookup]
			    RETURN
			        IF(
			            COUNTROWS(
			                FILTER(
			                    W_MNJ_BPO_ORDER_DETAILS_F,
			                    W_MNJ_BPO_ORDER_DETAILS_F[BUYER_ID] = 1051 &&
			                    W_MNJ_BPO_ORDER_DETAILS_F[SEASONS_Lookup] < CurrentSeason &&
			                    W_MNJ_BPO_ORDER_DETAILS_F[STYLE_Lookup] = CurrentStyle
			                )
			            ) > 0,
			            "Repeat",
			            "New"
			        ),
			    BLANK()
			)
		lineageTag: 81461943-699f-48f6-9b9c-9efe23d37408
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FOB_QuantiyVALUE = W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]*W_MNJ_BPO_ORDER_DETAILS_F[FOB]
