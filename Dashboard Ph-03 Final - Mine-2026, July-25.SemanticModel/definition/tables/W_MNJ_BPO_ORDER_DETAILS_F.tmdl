	column ACTUAL_SHIP_DATE_lookup =
			
			VAR ShipDate =
			    CALCULATE(
			        MAX(W_MNJ_ONTIME_SHIPMENT_F[ACTUAL_SHIP_DATE]),
			        FILTER(
			            W_MNJ_ONTIME_SHIPMENT_F,
			            W_MNJ_ONTIME_SHIPMENT_F[BPO_NO] = W_MNJ_BPO_ORDER_DETAILS_F[BPO_NO]
			        )
			    )
			
			VAR CheckZero =
			    IF(
			        W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY] = 0 && W_MNJ_BPO_ORDER_DETAILS_F[SHIP_QTY] = 0,
			        BLANK(),  -- Keeps it as a blank value to maintain date format
			        ShipDate
			    )
			
			RETURN
			CheckZero
		formatString: General Date
		lineageTag: 2bffa3e9-fabe-4d15-8659-8b59ba2c18e5
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 12b0943a-ec6f-49e6-bc5d-d96dc4ccd2fc
			defaultHierarchy: LocalDateTable_8ff1bff6-3fff-4246-b547-c1bd77c89849.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column YearColumn = ```
			
			IF(
			    ISBLANK(W_MNJ_BPO_ORDER_DETAILS_F[ACTUAL_SHIP_DATE_lookup]), 
			    "Not Shipped Yet", 
			    FORMAT(YEAR(W_MNJ_BPO_ORDER_DETAILS_F[ACTUAL_SHIP_DATE_lookup]), "General Number")
			)
			```
