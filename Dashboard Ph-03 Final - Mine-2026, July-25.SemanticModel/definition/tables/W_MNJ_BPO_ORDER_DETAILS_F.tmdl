	column POShipStatus = ```
			
			VAR ShipQty          = W_MNJ_BPO_ORDER_DETAILS_F[SHIP_QTY]
			VAR Quantity         = W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]
			VAR ShipmentDate     = W_MNJ_BPO_ORDER_DETAILS_F[USHIPMENT_DATE]
			VAR ActualShipDate   = W_MNJ_BPO_ORDER_DETAILS_F[ACTUAL_SHIP_DATE]
			
			VAR IsShipQtyBlankOrZero     = ISBLANK(ShipQty) || ShipQty = 0
			VAR IsQuantityBlankOrZero    = ISBLANK(Quantity) || Quantity = 0
			VAR HasActualShipDate        = NOT ISBLANK(ActualShipDate)
			
			RETURN 
			    IF(
			        IsShipQtyBlankOrZero && IsQuantityBlankOrZero,
			        BLANK(),
			        IF(
			            IsShipQtyBlankOrZero && NOT ISBLANK(ShipmentDate) && ShipmentDate < TODAY() - 5,
			            "Zero Ship Date Pass",
			            IF(
			                Quantity = ShipQty, "Full",
			                IF(
			                    Quantity > ShipQty && HasActualShipDate, "Short",
			                    IF(
			                        Quantity < ShipQty, "Excess",
			                        BLANK()
			                    )
			                )
			            )
			        )
			    )
			```
		lineageTag: 8f3da0c1-c260-450d-a519-ecb75655665b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

