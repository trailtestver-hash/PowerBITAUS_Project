			VAR PreviousQty = 
			    CALCULATE(
			        SUM(Summarized_Table[Sum_Ship_QTY]),
			        FILTER(
			            Summarized_Table,
			            VALUE(LEFT(Summarized_Table[SEASONS_Lookup], 2)) = 
			            VALUE(LEFT(SELECTEDVALUE(Summarized_Table[SEASONS_Lookup]), 2)) - 1
			        )
			    )
			
			RETURN
			IF(
			    NOT(ISBLANK(PreviousQty)) && PreviousQty <> 0,
			    DIVIDE(CurrentQty - PreviousQty, PreviousQty, 0),
			    BLANK()
			)
