	column MeasureTable
		dataType: string
		lineageTag: a15c6013-fc3a-4354-8477-e9a4295e448c
		summarizeBy: none
		sourceColumn: MeasureTable

		annotation SummarizationSetBy = Automatic

	column GrowthTGASeason = ```
			
			VAR ValidData = 
			    FILTER(
			        W_MNJ_BPO_ORDER_DETAILS_F,
			        NOT(ISBLANK(W_MNJ_BPO_ORDER_DETAILS_F[YeargrTGA])) // Excludes blank YeargrTGA rows
			    )
			
			VAR CurrentYear = 
			    SELECTEDVALUE(W_MNJ_BPO_ORDER_DETAILS_F[YeargrTGA])
			
			VAR CurrentQty =
			    CALCULATE(
			        SUM(W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]),
			        FILTER(
			            ValidData,
			            W_MNJ_BPO_ORDER_DETAILS_F[YeargrTGA] = CurrentYear
			        )
			    )
			
			VAR PreviousQty =
			    CALCULATE(
			        SUM(W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]),
			        FILTER(
			            ValidData,
			            W_MNJ_BPO_ORDER_DETAILS_F[YeargrTGA] = CurrentYear - 1
			        )
			    )
			
			RETURN
			IF(
			    NOT(ISBLANK(PreviousQty)) && PreviousQty <> 0,
			    DIVIDE(CurrentQty - PreviousQty, PreviousQty, 0),
			    BLANK()
			)
			```
		lineageTag: 7718d5f2-a76f-43c8-bfc3-8006c148c2b9
		summarizeBy: sum

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition MeasureTable = m
		mode: import
		source =
				let
				    Source = ""
				in
				    Source

	annotation PBI_ResultType = Text

