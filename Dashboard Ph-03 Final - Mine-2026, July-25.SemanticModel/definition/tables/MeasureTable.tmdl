			    SUMX(W_MNJ_BPO_ORDER_DETAILS_F, W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY])
			)
			```
		formatString: 0.00
		lineageTag: ff2ef6c8-75ed-4a8f-a9a1-d8d844a49877

	measure 'AverageW.Wash_BPOorder' =
			
			DIVIDE(
			    SUMX(
			        FILTER(
			            W_MNJ_BPO_ORDER_DETAILS_F,
			            NOT(ISBLANK(RELATED(W_MNJ_POC_COLOR_WASH_D[WASH_COST]))) &&
			            RELATED(W_MNJ_POC_COLOR_WASH_D[WASH_COST]) <> 0
			        ),
			        W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY] * RELATED(W_MNJ_POC_COLOR_WASH_D[WASH_COST])
			    ),
			    SUMX(
			        FILTER(
			            W_MNJ_BPO_ORDER_DETAILS_F,
			            NOT(ISBLANK(RELATED(W_MNJ_POC_COLOR_WASH_D[WASH_COST]))) &&
			            RELATED(W_MNJ_POC_COLOR_WASH_D[WASH_COST]) <> 0
			        ),
			        W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]
			    )
			)
		formatString: 0.00
		lineageTag: 3271b447-a62f-4866-9546-3d389de85ebb

	measure 'AverageW.CMBPOorder' = ```
			
			DIVIDE(
			    SUMX(
			        FILTER(
			            W_MNJ_BPO_ORDER_DETAILS_F, 
			            NOT(ISBLANK(RELATED(W_MNJ_POC_COLOR_WASH_D[CM]))) &&
			            RELATED(W_MNJ_POC_COLOR_WASH_D[CM]) <> 0
			        ),
			        W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY] * RELATED(W_MNJ_POC_COLOR_WASH_D[CM])
			    ),
			    SUMX(
			        FILTER(
			            W_MNJ_BPO_ORDER_DETAILS_F, 
			            NOT(ISBLANK(RELATED(W_MNJ_POC_COLOR_WASH_D[CM]))) &&
			            RELATED(W_MNJ_POC_COLOR_WASH_D[CM]) <> 0
			        ),
			        W_MNJ_BPO_ORDER_DETAILS_F[QUANTITY]
			    ),
			    0  -- Avoids division errors if denominator is 0
			)
			```
		formatString: 0.00
		lineageTag: bda1ff60-1e59-49c5-8054-2acd0ce1667e

	measure Cut_Excess_Cuttoshipment =
			
			DIVIDE(
			    SUMX(
			        FILTER(
			            'W_MNJ_CUT_TO_SHIPMENT_F',
			            (
			                (NOT ISBLANK('W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY]) && 'W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY] <> 0)
			                || (NOT ISBLANK('W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY]) && 'W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY] <> 0)
			            )
			        ),
			        VAR OrderQtyAdj =
			            IF(
			                'W_MNJ_CUT_TO_SHIPMENT_F'[STATUS] = 1
			                && (ISBLANK('W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY]) || 'W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY] = 0),
			                0,   -- override ORDER_QTY to 0
			                'W_MNJ_CUT_TO_SHIPMENT_F'[ORDER_QTY]
			            )
			        RETURN
			            'W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY] - OrderQtyAdj
			    ),
			    [OrderQtyCuttoship],   -- denominator stays as your existing measure
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f50e774f-efa2-45ee-ba1a-3ccc1b9d342d

	measure Cut_loss_Cuttoshipment = ```
			
			IF(
			    SUM('W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY]) = 0 && SUM('W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY]) > 0, 
			    -1,  -- Returns -100% for full shipment excess
			    IF(
			        SUM('W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY]) > 0 && SUM('W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY]) = 0, 
			        1,  -- Returns +100% for full cut loss
			        DIVIDE(
			            SUM('W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY]) - SUM('W_MNJ_CUT_TO_SHIPMENT_F'[SHIP_QTY]),  
			            SUM('W_MNJ_CUT_TO_SHIPMENT_F'[CUT_QTY]),  
			            0  -- Avoids division errors
			        )
			    )
			)  -- Converts to percentage format
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 73e1c018-f0ac-4c6a-9fe2-97fe5294e394

