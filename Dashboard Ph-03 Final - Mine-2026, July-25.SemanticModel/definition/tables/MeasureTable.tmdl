	measure ShortShipGrowth2 =
			
			VAR PreviousYearShortShipmentQty =
			    CALCULATE(
			        [Short/Excess_Qty],
			        SAMEPERIODLASTYEAR('Calendar'[Date])
			    )
			
			VAR CurrentYearShortShipmentQty =
			    [Short/Excess_Qty]
			
			VAR GrowthRate =
			    IF(
			        PreviousYearShortShipmentQty <> 0,
			        DIVIDE(CurrentYearShortShipmentQty - PreviousYearShortShipmentQty, ABS(PreviousYearShortShipmentQty)),
			        BLANK()
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(GrowthRate),
			    MAX(-0.5, MIN(GrowthRate, 0.5)),  // Bound growth rate between -0.5 and 0.5
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: edfd99f0-e9a6-426a-843f-94c9dd2dcbaa

