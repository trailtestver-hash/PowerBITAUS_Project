	measure Growth_Yearly_SHIP_QTY = ```
			
			VAR CurrentYearShipQty = 
			    SUM(W_MNJ_BPO_ORDER_DETAILS_F[SHIP_QTY])
			VAR PreviousYearShipQty = 
			    CALCULATE(
			        SUM(W_MNJ_BPO_ORDER_DETAILS_F[SHIP_QTY]),
			        SAMEPERIODLASTYEAR(Calendar[Date])
			    )
			RETURN 
			IF(
			    ISBLANK(PreviousYearShipQty), 
			    BLANK(),
			    DIVIDE(CurrentYearShipQty - PreviousYearShipQty, PreviousYearShipQty, 0)
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 84e0858e-175d-4800-831b-84a7875f305e

	measure 'AverageW.FOBPOorder' = ```
			
			DIVIDE(
			    SUMX(  
