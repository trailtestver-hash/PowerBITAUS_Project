	measure ShipGapInteractiveArrow =
			
			IF(
			    [ShipGapInteractive] > 0,
			    UNICHAR(9650) & " " & FORMAT([ShipGapInteractive] / 1000000, "0.000") & "M ", -- Up arrow with "M"
			    IF(
			        [ShipGapInteractive] < 0,
			        UNICHAR(9660) & " " & FORMAT([ShipGapInteractive] / 1000000, "0.000") & "M ", -- Down arrow with "M"
			        FORMAT([ShipGapInteractive] / 1000000, "0.000") & "M" -- No change, with "M"
