	column 'Buyer Name short' = ```
			
			VAR DisplayName = LOOKUPVALUE(
			    CustomerMapping[DisplayName],
			    CustomerMapping[OriginalName], 'W_MNJ_CUSTOMER_D'[CUSTOMER_NAME]
			)
			RETURN IF(
			    ISBLANK(DisplayName),
			    'W_MNJ_CUSTOMER_D'[CUSTOMER_NAME],
			    DisplayName
			)
			
			```
		lineageTag: 76568934-74e3-41e1-82c7-a0439595b1eb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Unit_Look_Cus =
			
			SWITCH(
			    TRUE(),
			    W_MNJ_CUSTOMER_D[CUSTOMER_ID] IN {1052, 18213, 366396, 6159, 362396}, "CGL",
			    W_MNJ_CUSTOMER_D[CUSTOMER_ID] IN {305394, 334396, 360396, 1050, 1051, 1086, 23222, 1046, 311394, 363396, 321394}, "CAL",
			    "Not CALCGL"
			)
		lineageTag: 0d41a84c-9416-4e77-8756-303c1c6c9128
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

