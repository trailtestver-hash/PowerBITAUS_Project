	column SEASONs =
			
			IF(
			    W_MNJ_POC_H_D[CUSTOMER_NAME] = "Target Australia PTY Ltd.",
			    LOOKUPVALUE(
			        TGASeasonSort[Season_Sort],   // Column to retrieve
			        TGASeasonSort[SEASON],        // Lookup column in TGASeasonSort
			        W_MNJ_POC_H_D[SEASON]         // Matching column in W_MNJ_POC_H_D
			    ),
			    W_MNJ_POC_H_D[SEASON]  // Default to original SEASON value
			)
		lineageTag: ccb80163-3115-491a-8b3a-d3408a4e8b1d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Unit_Look_POC =
			
			SWITCH(
			    TRUE(),
			
			    // CGL Group
			    W_MNJ_POC_H_D[CUSTOMER_NAME] IN {
			        "EMEA Aspire Trading FZE", "Target Stores", "LEVI STRAUSS & CO.",
			        "Silver Moon Jeans", "ITX TRADING S.A.", "VF Sourcing ASIA S.A.R.L."
			    }, "CGL",
			
			    // CAL Group with exclusions based on CUSTOMER_NAME + ALTIMATE_BUYER combo
			    W_MNJ_POC_H_D[CUSTOMER_NAME] IN {
			        "WHO SAYS ? INC", "The Gap, Inc.", "Target Australia PTY Ltd.", "GU Co., Ltd",
			        "DESIGN SOURCING INTERNATIONAL CORP", "JeansBlue",
			        "KONTOOR ASIA TRADING LIMITED", "BRIARA TRADING COMPANY", "M&J (HK) LIMITED",
			        "FOREVER 21, INC"
			    }
			    &&
			    NOT (
			        W_MNJ_POC_H_D[CUSTOMER_NAME] = "M&J (HK) LIMITED"
			        && W_MNJ_POC_H_D[ALTIMATE_BUYER] IN {
			            "NEW YORKER FASHION LOGISTICS INTERNATIONAL GMBH &",
			            "DIESEL",
			            "CENTRIC DENIM USA LLC",
			            "VARNER"
			        }
			    ), "CAL",
			
			    // Default
			    "Not CALCGL"
			)
		lineageTag: 775606f5-2ef6-4dad-bb9a-8f0c869cec37
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column BRAND
		dataType: string
		lineageTag: 841a99ce-3104-4a98-b306-6416ab7da49a
		summarizeBy: none
		sourceColumn: BRAND

		annotation SummarizationSetBy = Automatic

	column 'Buyer Name shortPOC' =
			
			VAR DisplayName = LOOKUPVALUE(
			    CustomerMapping[DisplayName],
			    CustomerMapping[OriginalName], 'W_MNJ_POC_H_D'[CUSTOMER_NAME]
			)
			RETURN IF(
			    ISBLANK(DisplayName),
			    'W_MNJ_POC_H_D'[CUSTOMER_NAME],
			    DisplayName
			)
		lineageTag: 1486364d-e5b7-4138-8481-49e2e236c447
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'AltBuyer Name Short' =
			
			VAR DisplayName = LOOKUPVALUE(
			    CustomerMapping[DisplayName],
			    CustomerMapping[OriginalName], 'W_MNJ_POC_H_D'[ALTIMATE_BUYER]
			)
			RETURN IF(
			    ISBLANK(DisplayName),
			    'W_MNJ_POC_H_D'[ALTIMATE_BUYER],
			    DisplayName
			)
		lineageTag: dfaae94b-ab0c-40fa-a6a3-1aafee24d6ff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition W_MNJ_POC_H_D = m
		mode: import
		source =
				let
				    Source = Oracle.Database("192.168.200.141:1521/biprod2", [HierarchicalNavigation=true]),
				    DEV_DW = Source{[Schema="DEV_DW"]}[Data],
				    W_MNJ_POC_H_D1 = DEV_DW{[Name="W_MNJ_POC_H_D"]}[Data]
				in
