			defaultHierarchy: LocalDateTable_a798eef1-cae6-4c19-9126-f289fb3b0830.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column STYLE_Mark =
			
			VAR LastShipDate =
			    CALCULATE(
			        MAX(W_MNJ_CUT_TO_SHIPMENT_F[SHIPDATE]),
			        ALLEXCEPT(W_MNJ_CUT_TO_SHIPMENT_F, W_MNJ_CUT_TO_SHIPMENT_F[STYLE], W_MNJ_CUT_TO_SHIPMENT_F[SEASON])  -- Group by STYLE & SEASON
			    )
			
			VAR IsValid =
			    IF(
			        LastShipDate < TODAY() - 5,
			        "StyleClose",
			        "Running"
			    )
			
			VAR CheckBlankRows =
			    IF(
			        (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[ORDER_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[ORDER_QTY] = 0) &&
			        (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY] = 0) &&
			        (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY] = 0),
			        "Nill",  -- Instead of BLANK()
			        IsValid  -- Otherwise, return "StyleClose"/"Running"
			    )
			
			VAR CheckCutShipBlank =
			    IF(
			        (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY] = 0) &&
			        (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY] = 0),
			        "Nill",  -- Instead of BLANK()
			        CheckBlankRows
			    )
			
			RETURN CheckCutShipBlank
		lineageTag: f534ed3d-47b7-40de-9fd3-27ebfc4438f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ShipmentStatus = ```
			
			IF(
			    ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[UShipDate]), 
			    "PO Shipped",
			    IF(
			        W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY] > 0, 
			        "PO Shipped",
			        IF(
			            W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY] = 0 && 
			            DATEDIFF(W_MNJ_CUT_TO_SHIPMENT_F[UShipDate], TODAY(), DAY) > 5,
			            "Nill",
			            IF(
			                (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[CUT_QTY] = 0) &&
			                (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[SHIP_QTY] = 0) &&
			                (ISBLANK(W_MNJ_CUT_TO_SHIPMENT_F[ORDER_QTY]) || W_MNJ_CUT_TO_SHIPMENT_F[ORDER_QTY] = 0),
			                "Nill",
			                BLANK()  -- Default case if none of the conditions match
			            )
			        )
			    )
			)
			```
		lineageTag: db523734-29de-4ae9-b1bd-1ec95931eb5b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column StyleStatus =
			
			VAR TotalRows =
			    CALCULATE(
			        COUNTROWS(W_MNJ_CUT_TO_SHIPMENT_F),
			        ALLEXCEPT(W_MNJ_CUT_TO_SHIPMENT_F, W_MNJ_CUT_TO_SHIPMENT_F[STYLE], W_MNJ_CUT_TO_SHIPMENT_F[SEASON])
			    )
			
			VAR ShippedRows =
			    CALCULATE(
			        COUNTROWS(W_MNJ_CUT_TO_SHIPMENT_F),
			        ALLEXCEPT(W_MNJ_CUT_TO_SHIPMENT_F, W_MNJ_CUT_TO_SHIPMENT_F[STYLE], W_MNJ_CUT_TO_SHIPMENT_F[SEASON]),
			        W_MNJ_CUT_TO_SHIPMENT_F[ShipmentStatus] = "PO Shipped"
			    )
			
			VAR NillRows =
			    CALCULATE(
			        COUNTROWS(W_MNJ_CUT_TO_SHIPMENT_F),
			        ALLEXCEPT(W_MNJ_CUT_TO_SHIPMENT_F, W_MNJ_CUT_TO_SHIPMENT_F[STYLE], W_MNJ_CUT_TO_SHIPMENT_F[SEASON]),
			        W_MNJ_CUT_TO_SHIPMENT_F[ShipmentStatus] = "Nill"
			    )
			
			RETURN
			IF(
			    ShippedRows + NillRows = TotalRows,  -- If all rows are either "PO Shipped" or "Nill"
			    "StyleClose",
			    "Running"
			)
		lineageTag: 65e07b54-50db-4292-a7dc-34c292cf0ef2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

