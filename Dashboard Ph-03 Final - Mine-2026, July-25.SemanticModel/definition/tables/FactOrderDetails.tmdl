	column OrderQtyCategoryColumn = ```
			
			VAR TotalOrderQty = 
			    CALCULATE(
			        SUM(FactOrderDetails[QTY]),
			        ALLEXCEPT(FactOrderDetails, FactOrderDetails[STYLE])
			    )
			RETURN
			    IF(
			        TotalOrderQty > 5000,
			        "Above 5000 pcs",
			        "Below 5000 pcs"
			    )
			
			```
		lineageTag: 6ca707c1-96d6-424d-9cbe-2cc4157216ab
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

