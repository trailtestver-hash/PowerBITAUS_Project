	column PORange = ```
			
			SWITCH(
			    TRUE(),
			    FactOrderDetails[QTY] < 300, "Below 300",
			    FactOrderDetails[QTY] < 550, "Range 500",
			    FactOrderDetails[QTY] < 1050, "Range 1000",
			    FactOrderDetails[QTY] < 1550, "Range 1500",
			    FactOrderDetails[QTY] < 2050, "Range 2000",
			    FactOrderDetails[QTY] < 2550, "Range 2500",
			    FactOrderDetails[QTY] < 3050, "Range 3000",
			    FactOrderDetails[QTY] < 3550, "Range 3500",
			    FactOrderDetails[QTY] < 4050, "Range 4000",
			    FactOrderDetails[QTY] < 4550, "Range 4500",
			    FactOrderDetails[QTY] < 5050, "Range 5000",
			    FactOrderDetails[QTY] < 5550, "Range 5500",
			    FactOrderDetails[QTY] < 6050, "Range 6000",
			    FactOrderDetails[QTY] < 6550, "Range 6500",
			    FactOrderDetails[QTY] < 7050, "Range 7000",
			    FactOrderDetails[QTY] < 8550, "Range 8500",
			    FactOrderDetails[QTY] < 9050, "Range 9000",
			    FactOrderDetails[QTY] < 10050, "Range 10000",
			    FactOrderDetails[QTY] < 10550, "Range 10500",
			    FactOrderDetails[QTY] < 11050, "Range 11000",
			    FactOrderDetails[QTY] < 11550, "Range 11500",
			    FactOrderDetails[QTY] < 12050, "Range 12000",
			    "Above 12000"
			)
			
			```
		lineageTag: 63b8c586-54ff-472a-87ad-d08bc9eeab58
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

